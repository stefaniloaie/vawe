{
  "name": "live-events",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "dev:api": ".venv/bin/python backend/manage.py runserver 0.0.0.0:8000",
    "dev:all": "bash scripts/dev.sh",
    "build": "vite build",
    "start": ".venv/bin/gunicorn --chdir backend vawe_backend.wsgi:application --bind 0.0.0.0:${PORT:-8000}",
    "migrate": ".venv/bin/python backend/manage.py migrate",
    "test:api": ".venv/bin/python backend/manage.py test live_data",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
