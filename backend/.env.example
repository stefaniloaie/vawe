# Required for a public deployment; use a long random value.
DJANGO_SECRET_KEY=replace-before-deployment
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=your-domain.example
VAWE_SITE_URL=https://your-domain.example
VAWE_DEFAULT_BUOY=46026
VAWE_WEATHER_LAT=37.7749
VAWE_WEATHER_LON=-122.4194

# Start with the local Django cache. Configure Redis in production without changing API code.
# DJANGO_CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
# DJANGO_CACHE_LOCATION=redis://127.0.0.1:6379/1

# Air needs an OpenSky OAuth client. Ships and traffic need a provider you license.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
AIS_PROVIDER_URL=
AIS_API_KEY=
TRAFFIC_PROVIDER_URL=
TRAFFIC_API_KEY=
